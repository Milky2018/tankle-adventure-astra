import {
  "milky/tankle-astra/host",
  "moonbitlang/core/json",
  "milky/tankle-astra/tests/browser/protocol",
  "moonbit-community/three/core",
  "moonbitlang/core/async/js_async",
  "tiye/dom-ffi" @dom,
}

pkgtype(kind: "executable")

supported_targets = "js"

options(
  "allow-experimental-packages": true,
  link: { "js": { "format": "iife" } },
)

import {
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/compress/gzip",
  "moonbitlang/core/async/io",
  "moonbitlang/core/path",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/encoding/percent",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "milky/tankle-astra/tooling/editor_model" @model,
  "milky/tankle-astra/tooling/archive",
  "milky/tankle-astra/tooling/node",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/async",
}

pkgtype(kind: "executable")

supported_targets = "js"

options(
  "allow-experimental-packages": true,
)

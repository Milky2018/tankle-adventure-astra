import {
  "milky/tankle-astra/tooling/editor_model" @model,
  "milky/tankle-astra/tooling/archive",
  "moonbit-community/three/math",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "tiye/dom-ffi" @dom,
}

pkgtype(kind: "executable")

supported_targets = "js"

options(
  "allow-experimental-packages": true,
  link: { "js": { "format": "esm" } },
)

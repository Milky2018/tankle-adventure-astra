///|
pub fn authored_world() -> World {
  let architecture = authored_architecture()
  {
    decks: authored_decks(),
    solids: authored_solids(),
    obstacles: authored_obstacles(),
    architecture,
    architecture_grid: architecture_grid(architecture),
    lifts: authored_lifts(),
  }
}
